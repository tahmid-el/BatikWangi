{
  "name": "batikwangi",
  "version": "1.0.0",
  "private": true,
  "description": "BatikWangi — katalog & manajemen UMKM batik dan kebaya Banyuwangi (admin, seller, pembeli)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/seed.js --reset",
    "css:build": "tailwindcss -i src/tailwind.css -o public/assets/app.css --minify",
    "assets": "cp node_modules/lucide/dist/umd/lucide.min.js public/vendor/lucide.min.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide": "^0.468.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
